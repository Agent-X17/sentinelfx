# Documentation only. Export these variables before starting the server.
SYSTEM_MODE=SIMULATION
LIVE_EXECUTION_ENABLED=false
DATABASE_PATH=data/engine.sqlite3
DEFAULT_ACCOUNT_PROFILE=ACCOUNT_LIVE

# TradingView webhook. Leave blank only for localhost development.
TRADINGVIEW_WEBHOOK_SECRET=replace-with-a-long-random-secret
WEBHOOK_MAX_AGE_SECONDS=300
# Comma-separated tunnel hostnames only: no scheme and no URL path. Localhost is always allowed.
# External hosts are accepted only on the webhook route; the remote dashboard remains refused.
WEBHOOK_ALLOWED_HOSTS=

# disabled (default), mock (safe synthetic diagnostics), or real (supported host only).
# Real diagnostics require a controlled Windows host, the official MetaTrader5 package,
# a running MT5 terminal, and a demo-only login. Never put credentials in this file.
MT5_DIAGNOSTIC_MODE=disabled
# Legacy compatibility: MT5_ENABLED=true selects real when the mode above is unset.
MT5_ENABLED=false
MT5_TERMINAL_PATH=
EXPLICIT_ORDER_CONFIRMATION_REQUIRED=true

# Manual-confirmed demo proposals. Both switches must be changed locally.
# Keep disabled and killed until read-only account evidence is fully configured.
DEMO_TRADE_PROPOSALS_ENABLED=false
DEMO_TRADE_PROPOSAL_KILL_SWITCH=true
DEMO_PROPOSAL_EXPIRY_MINUTES=10
DEMO_MAX_RISK_PER_TRADE_PCT=0.25
DEMO_MAX_DAILY_LOSS_PCT=1.0
DEMO_MAX_OPEN_POSITIONS=1
DEMO_MAX_TRADES_PER_DAY=2
# Supply locally through the environment. Never commit account identity values.
DEMO_EXPECTED_ACCOUNT_LOGIN=
DEMO_EXPECTED_BROKER_SERVER=
