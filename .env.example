# Documentation only. Export these variables before starting the server.
SYSTEM_MODE=SIMULATION
LIVE_EXECUTION_ENABLED=false
DATABASE_PATH=data/engine.sqlite3
DEFAULT_ACCOUNT_PROFILE=ACCOUNT_LIVE

# TradingView webhook. Leave blank only for localhost development.
TRADINGVIEW_WEBHOOK_SECRET=replace-with-a-long-random-secret
WEBHOOK_MAX_AGE_SECONDS=300
# Comma-separated tunnel hosts, with port when applicable. Localhost is always allowed.
WEBHOOK_ALLOWED_HOSTS=

# disabled (default), mock (safe synthetic diagnostics), or real (supported host only).
MT5_DIAGNOSTIC_MODE=disabled
# Legacy compatibility: MT5_ENABLED=true selects real when the mode above is unset.
MT5_ENABLED=false
MT5_TERMINAL_PATH=
EXPLICIT_ORDER_CONFIRMATION_REQUIRED=true
